# Do not list the contents of directories that have no index.html.
Options -Indexes

# Generated with ngx-htaccess-generator v1.2.4
# Check for updates: https://julianpoemp.github.io/ngx-htaccess-generator/

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirection to HTTPS:
  RewriteCond %{HTTPS} !on
  RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Redirection of requests to index.html
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteRule ^.*$ - [NC,L]
  # Redirect all non-file routes to index.html
  RewriteRule ^(?!.*\.).*$ index.html [NC,L]
</IfModule>

# Browser cache.
# Every file is kept by the browser, which checks with the server before
# using it again (a short 304 when it has not changed): index.html, the
# images and uploads/episodes/<n>/ can be replaced on the server under the
# same name and show up at once.
# The sounds in audio/ are the exception: they are kept for a month without
# checking, so that each right or wrong answer does not wait for the server.
# A replaced sound needs a new URL to show up at once: see the README,
# « Notes de configuration ».
# The check relies on Last-Modified only: compression adds -gzip or -br to
# the ETag, which then never matches and turns every 304 into a full 200.
# The bundles built by Angular have a hash of their content in their name
# (main-53JVCIJM.js, styles-3CA2LQGU.css): a new build gives new names, so
# they are kept for a year without checking. Upload index.html last, so that
# no visitor gets a bundle that is still being uploaded.
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
  Header set Cache-Control "no-cache"
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/audio/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
</IfModule>
